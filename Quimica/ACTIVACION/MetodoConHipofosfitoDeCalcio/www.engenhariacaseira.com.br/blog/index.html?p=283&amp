			<div class="amp-wp-meta amp-wp-byline">
					<amp-img src="https://secure.gravatar.com/avatar/3ce4490f782456e09b3a8d6cdd52e4f0f15d7a8a422d2cb4b550e70ac30a59ad?s=72&amp;d=mm&amp;r=pg" srcset="
