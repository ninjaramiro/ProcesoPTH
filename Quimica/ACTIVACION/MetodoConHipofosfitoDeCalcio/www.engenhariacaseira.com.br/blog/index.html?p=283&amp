				" alt="Ricardo" width="24" height="24" layout="fixed" class="i-amphtml-layout-fixed i-amphtml-layout-size-defined" style="width:24px;height:24px" i-amphtml-layout="fixed"></amp-img>
				<span class="amp-wp-author author vcard">Ricardo</span>
	</div>
<div class="amp-wp-meta amp-wp-posted-on">
	<time datetime="2017-09-05T16:17:17+00:00">
